# Claude API (for writing agents - optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# BrightData API (required for LinkedIn KOL scraping)
BRIGHTDATA_API_KEY=your_brightdata_api_key_here
BRIGHTDATA_ZONE=mcp_unlocker

# LinkedIn KOL profiles file (optional - defaults to ./data/linkedin_kol_sample.json)
# For local development with full list, set to ./data/linkedin_kol_full.json
LINKEDIN_KOL_PROFILES_FILE=./data/linkedin_kol_sample.json